# ═══════════════════════════════════════════════════════════
# 三交易所整合网格机器人 · 配置文件
# 复制本文件为 .env 并填入对应值
# ═══════════════════════════════════════════════════════════

# 服务端口（默认 8080）；Dokploy/容器部署时由平台注入或在此指定
PORT=8080
# 监听地址：本地默认 127.0.0.1（仅本机）；Dokploy/容器部署必须设 0.0.0.0（Dockerfile 已默认）
# HOST=0.0.0.0

# 模拟账户初始余额 USDC（paper 模式共用）
PAPER_BALANCE=10000

# ── 代理 / IP 配置 ────────────────────────────────────────
# 全局代理：同时应用于所有三个交易所（优先级最高）
# 留空则各交易所使用各自的独立代理配置
# 支持格式：
#   HTTP(S):  http://127.0.0.1:7890
#   SOCKS5:   socks5://127.0.0.1:1080
#   带认证:   socks5://user:pass@host:port
#   简写格式: host:port:user:pass
GLOBAL_PROXY=

# 各交易所独立代理（仅在 GLOBAL_PROXY 未设置时生效）
DECIBEL_PROXY=
EXTENDED_PROXY=
RISEX_PROXY=

# ── Decibel 交易所 ────────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）
DE_MODE=paper
# 网络：mainnet | testnet
DE_NETWORK=mainnet

# 实盘凭据（DE_MODE=live 时必填）
# API Key：在 geomi.dev 创建
DECIBEL_API_KEY=
# API 钱包 Ed25519 私钥：在 app.decibel.trade/api 创建
DECIBEL_PRIVATE_KEY=
# Trading Account 地址
DECIBEL_SUBACCOUNT=
# 自定义 API URL（留空使用默认）
DECIBEL_API_URL=

# ── Extended 交易所 ───────────────────────────────────────
EX_MODE=paper
EX_NETWORK=mainnet

# 实盘凭据（EX_MODE=live 时必填）
# 在 app.extended.exchange → API Management 获取
EXTENDED_API_KEY=
EXTENDED_VAULT=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_MAX_FEE=0.0005
EXTENDED_API_URL=

# ── RISEx 交易所 ──────────────────────────────────────────
RS_MODE=paper
RS_NETWORK=mainnet

# 实盘凭据（RS_MODE=live 时必填）
ACCOUNT_ADDRESS=
SIGNER_PRIVATE_KEY=
RISEX_API_URL=
RISEX_WS_URL=

# ── AI 助手（可选：风控哨兵/日报/市况分析/对话操控/出区间建议）──
# 协议类型：openai | anthropic | gemini
#   openai = 所有 OpenAI 兼容服务（OpenAI/DeepSeek/Kimi/通义/智谱/OpenRouter/Ollama 等）
AI_PROVIDER=openai
AI_API_KEY=
# 接口地址（留空用官方默认）。示例：
#   DeepSeek: https://api.deepseek.com/v1    Kimi: https://api.moonshot.cn/v1
#   通义: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地: http://127.0.0.1:11434/v1
AI_BASE_URL=
# 主模型（复盘/分析/对话）与小模型（哨兵巡检，高频省钱，可留空同主模型）
AI_MODEL=
AI_MODEL_SMALL=
# 哨兵巡检间隔（分钟，0=关闭）；BTC 市况报告间隔（分钟，0=关闭）；日报生成时间（0-23 整点）
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选，配了才会推）：Telegram 机器人 + 通用 Webhook（POST {"text":...}）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=

# ════ 登录认证（必需：仪表盘只有登录后才能使用）═══════════════════════════
# 白名单邮箱：只有这个邮箱 + 正确密码才能登录（仅此一个账号）
LOGIN_EMAIL=jaychougo@gmail.com
# 登录密码的 scrypt 哈希（绝不存明文）。生成方法：在项目目录运行
#   npm run hash        （或  node src/auth.js hash）
# 按提示输入两次密码，把输出的 LOGIN_PASSWORD_HASH=scrypt:... 整行粘贴到下面
LOGIN_PASSWORD_HASH=
# 会话签名密钥：建议设成一段随机字符串（≥32 位），保证重启程序后不掉登录。
# 留空则每次启动随机生成、重启后需重新登录。生成示例：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 会话有效期（小时），默认 720（30 天）
SESSION_TTL_HOURS=720
# 部署在 HTTPS（反向代理）下时设 true 让登录 cookie 带 Secure；本机 http 访问保持 false
# Dokploy 自带 HTTPS，部署在那里应设 SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=false
# 数据库文件路径（默认 data/app.db）。Dokploy 部署时把 /app/data 挂为持久卷
# DB_PATH=data/app.db
